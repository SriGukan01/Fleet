# ==============================================================================
# VERITRUST AI — Environment Configuration Example
# AICTE SIH26261 | Smart Automation
# ==============================================================================

# Application Meta
APP_NAME="VERITRUST AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Security (JWT & Password Hashing)
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Provide your MongoDB Atlas connection string here.
# If omitted or unavailable, VERITRUST AI automatically activates the
# built-in Local Document Store with zero external friction.
MONGODB_URL=""
MONGODB_DB_NAME="veritrust_ai"

# Document Storage Configuration ("local" or "s3")
STORAGE_TYPE="local"

# AI & Verification Providers ("local", "mock", "openai", "gemini")
AI_PROVIDER="local"
AI_API_KEY=""

# Gateway Sandboxes
DIGILOCKER_SANDBOX_MODE=true

# Processing & Safety Limits
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=30
